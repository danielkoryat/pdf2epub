# pdf2epub behind Cloudflare. Add this site to /etc/caddy/Caddyfile and run: sudo systemctl reload caddy
#
# Cloudflare proxies the domain (orange cloud) and passes the visitor's address in CF-Connecting-IP, which the
# app trusts. So only Cloudflare may connect: anyone reaching the server's address directly is cut off, and
# cannot fake that header. Cloudflare's ranges: https://www.cloudflare.com/ips/ (checked 2026-10-16).

pdf2epub.danielkoryat.com {
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	abort @not_cloudflare

	encode zstd gzip
	request_body {
		max_size 110MB
	}
	# The app sets its own security headers (CSP, HSTS, frame and referrer rules).
	reverse_proxy 127.0.0.1:5250 {
		transport http {
			response_header_timeout 5m
		}
	}
}
