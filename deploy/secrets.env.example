# Secrets: read by the web app only. Copy to secrets.env, fill in, then: chmod 600 secrets.env
# Never commit secrets.env.

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PDF2EPUB_SESSION_SECRET=

# Google Cloud console > APIs & Services > Credentials > OAuth client ID (Web application). See docs/deploy.md.
PDF2EPUB_GOOGLE_CLIENT_ID=
PDF2EPUB_GOOGLE_CLIENT_SECRET=

# Who gets the admin dashboard (comma-separated Google account e-mails)
PDF2EPUB_ADMIN_EMAILS=

# Optional: PostHog product analytics (project API key, public by design; EU host by default)
PDF2EPUB_POSTHOG_KEY=
# PDF2EPUB_POSTHOG_HOST=https://eu.i.posthog.com

# Optional but recommended with guests: Cloudflare Turnstile (dashboard > Turnstile > Add widget, hostname = the
# site). The site key is public; the secret key stays here.
PDF2EPUB_TURNSTILE_SITE_KEY=
PDF2EPUB_TURNSTILE_SECRET=

# Optional: audiobooks. The token the voice worker (a computer with a GPU, see docs/audiobooks.md) signs its
# requests with. Without it the voice worker API is off.
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PDF2EPUB_VOICE_TOKEN=
