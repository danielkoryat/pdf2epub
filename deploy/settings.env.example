# Settings shared by the web app and the worker. Nothing secret goes here: the worker reads this file too.
# Copy to settings.env and edit.

PDF2EPUB_MODE=server
PDF2EPUB_BASE_URL=https://pdf2epub.danielkoryat.com
PDF2EPUB_TIMEZONE=Asia/Jerusalem
# Read the visitor's address and country from Cloudflare's headers. Only safe because Caddy refuses
# connections that do not come from Cloudflare (see Caddyfile).
PDF2EPUB_TRUST_PROXY=true

# Limits (the defaults, except the upload size)
PDF2EPUB_FREE_PAGES_PER_MONTH=300
# Cloudflare (free plan) refuses request bodies over 100 MB, so stay a little below that.
PDF2EPUB_MAX_UPLOAD_MB=95
PDF2EPUB_MAX_PDF_PAGES=600
PDF2EPUB_MAX_JOBS_PER_DAY=10
PDF2EPUB_MAX_WAITING_JOBS=3
PDF2EPUB_MAX_STORAGE_MB=1024
PDF2EPUB_JOB_TIMEOUT_MINUTES=90

# Guests: people may convert without signing in. Their pages are counted per browser and per network
# (IPv4 address or IPv6 /64) together. PDF2EPUB_ALLOW_GUESTS=false turns this off.
PDF2EPUB_ALLOW_GUESTS=true
PDF2EPUB_GUEST_PAGES_PER_MONTH=60
PDF2EPUB_GUEST_JOBS_PER_DAY=3
PDF2EPUB_GUEST_MAX_STORAGE_MB=200
PDF2EPUB_GUESTS_PER_DAY=5
